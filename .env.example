SIMPLIFY_EXTENSION_ID=pbanhockgagggenencehbnadejlgchfc
# This is a dedicated, non-default profile required for Chrome CDP automation.
# Install Simplify and sign in once in this profile before running the app.
CHROME_AUTOMATION_USER_DATA_DIR=~/Library/Application Support/Google/Chrome-Automation
CHROME_PROFILE_DIRECTORY=Default
CHROME_DEBUGGING_PORT=9222
# Optional Telegram remote monitoring/control. Leave disabled to preserve CLI-only behavior.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Optional: set this if Chrome is not in its standard install location.
# CHROME_BINARY=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
